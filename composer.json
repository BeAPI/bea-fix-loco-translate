{
	"name": "bea/bea-fix-loco-translate",
	"description": "Compatibility improvements for Loco Translate.",
	"license": "GPL-3.0+",
	"type": "wordpress-muplugin",
	"keywords": [
		"Locostranslate"
	],
	"authors": [
		{
			"name": "Be API",
			"email": "technique@beapi.fr",
			"homepage": "https://beapi.fr/"
		}
	],
	"homepage": "https://github.com/BeAPI/bea-fix-loco-translate",
	"require": {
		"php": ">=7.4.0",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/php-compatibility": "^9.3",
		"phpro/grumphp-shim": "^1.13 || ^2.0",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"minimum-stability": "stable",
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpro/grumphp-shim": true
		}
	}
}
